# OpenRouter / OpenAI-compatible generation (Task 10)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
HYDE_ENABLED=0
FUSION_METHOD=rrf
FUSION_ALPHA=0.5
RAG_QUERY_MAX_VARIANTS=3
RAG_QUERY_MAX_WORDS=48
RAG_HYDE_MAX_WORDS=120
RAG_DISABLE_LLM_QUERY_VARIANTS=0
PAGEINDEX_FALLBACK_ENABLED=0

# Optional direct OpenAI fallback
OPENAI_API_KEY=sk-your-openai-key

# Jina AI (Task 7 - Reranking, optional)
JINA_API_KEY=jina_your-key
JINA_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_METHOD=cross_encoder
CHUNKING_METHOD=recursive
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# Mistral OCR (Milestone 1 OCR pilot)
MISTRAL_API_KEY=your-mistral-key
MISTRAL_OCR_MODEL=mistral-ocr-latest

# PageIndex (Task 8 - Vectorless RAG)
PAGEINDEX_API_KEY=pi_xxx
PAGEINDEX_INDEX_ID=xxx
PAGEINDEX_API_URL=https://api.pageindex.ai

# Weaviate Cloud (Task 4, optional - can use local Docker instead)
WEAVIATE_URL=https://xxx.weaviate.network
WEAVIATE_API_KEY=xxx

# Embedding model (if using API-based)
# COHERE_API_KEY=xxx
